{
  "name": "hermes-pocket",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile-first PWA client for Hermes Agent sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ptadigi/hermes-pocket.git"
  },
  "bugs": {
    "url": "https://github.com/ptadigi/hermes-pocket/issues"
  },
  "homepage": "https://github.com/ptadigi/hermes-pocket#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    ".env.example",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/",
    "index.html",
    "public/",
    "scripts/",
    "server/*.mjs",
    "server/*.py",
    "src/",
    "tests/",
    "tsconfig*.json",
    "vite.config.ts"
  ],
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently \"vite --host 127.0.0.1\" \"node --env-file=.env.local --watch server/index.mjs\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file=.env.local server/index.mjs",
    "start:background": "node scripts/start.mjs",
    "status": "node scripts/status.mjs",
    "startup:install": "node scripts/install-startup.mjs",
    "startup:uninstall": "node scripts/uninstall-startup.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "marked": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1"
  }
}
