{
  "name": "hermes-pocket",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"node --watch server/index.mjs\"",
    "build": "tsc -b && vite build",
